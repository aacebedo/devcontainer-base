root = true

[*]
indent_style = tab
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{yaml,yml,json,jsonc}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space

[*.toml]
indent_style = space

[Dockerfile]
indent_style = space
indent_size = 4
